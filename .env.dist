# Discord application, see https://discord.com/developers/applications
# General Information > Application ID
DISCORD_CLIENT_ID=
# Bot > Token
DISCORD_TOKEN=
# Optional: register commands only in this guild (instant, for development), else globally
DISCORD_DEV_GUILD_ID=

# PlayHex instance
# example for production: PLAYHEX_URL=https://playhex.org
PLAYHEX_URL=http://localhost:3000

# OAuth application created with:
# pnpm hex oauth:create-client --name "PlayHex Discord" --client-credentials --scope games:analyze --author ... --logo ...
PLAYHEX_CLIENT_ID=
PLAYHEX_CLIENT_SECRET=
